{
    "id": "transformer_inspection",
    "name": "主变自主巡视插件",
    "version": "1.0.0",
    "description": "主变外观缺陷识别、状态识别、热成像分析",
    "author": "A组",
    "category": "outdoor",
    "entrypoint": "plugin.py",
    "plugin_class": "TransformerInspectionPlugin",
    "capabilities": [
        "defect_detection",
        "state_recognition",
        "thermal_analysis"
    ],
    "verified_capabilities": [
        "state_recognition"
    ],
    "experimental_capabilities": [
        "defect_detection",
        "thermal_analysis"
    ],
    "blocked_capabilities": [],
    "required_fixtures": [
        "transformer_silicagel_sample.jpg",
        "transformer_oil_level_sample.jpg",
        "transformer_thermal_sample.jpg"
    ],
    "runtime_mode_support": {
        "real_dl": false,
        "traditional_fallback": true,
        "simulation": true
    },
    "current_known_limits": [
        "无真实图像回放数据集",
        "YOLOv8-ViT 模型为可选导入，当前环境不可用",
        "defect_detection 仅有 smoke test，无 fixture 级回归",
        "thermal_analysis 代码存在但缺少热成像样本验证",
        "已验证状态链路仅覆盖呼吸器硅胶和油位计"
    ],
    "device_types": [
        "transformer",
        "thermal_camera"
    ],
    "dependencies": [
        "numpy",
        "opencv-python"
    ],
    "min_platform_version": "1.0.0",
    "config_schema": {
        "type": "object",
        "properties": {
            "model": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "device": {"type": "string", "enum": ["cpu", "cuda"]}
                }
            },
            "inference": {
                "type": "object",
                "properties": {
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "nms_threshold": {"type": "number", "minimum": 0, "maximum": 1}
                }
            },
            "thermal": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "temperature_threshold": {"type": "number"}
                }
            }
        }
    }
}
