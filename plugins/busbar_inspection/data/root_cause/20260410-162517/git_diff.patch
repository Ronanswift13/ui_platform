 <script>
+    const simState = {
+        timer: null,
+        autoplay: true,
+        currentScenarioId: null,
+        history: [],
+        zones: [],
+    };
+
+    const zoneColors = ['var(--zone-a)', 'var(--zone-b)', '#f59e0b', '#34d399'];
+
+    async function apiJson(url, options = {}) {
+        const response = await fetch(url, {
+            headers: { 'Content-Type': 'application/json' },
+            ...options,
+        });
+        if (!response.ok) {
+            throw new Error(`HTTP ${response.status}`);
+        }
+        return response.json();
+    }
+
+    function statusClass(status) {
+        return `status-${(status || 'normal').toLowerCase()}`;
+    }
+
+    function formatTemp(value) {
+        if (value === null || value === undefined || Number.isNaN(Number(value))) {
+            return '--';
+        }
+        return `${Number(value).toFixed(1)} C`;
+    }
+
+    function formatRate(value) {
+        if (value === null || value === undefined || Number.isNaN(Number(value))) {
+            return '--';
+        }
+        return `${Number(value).toFixed(2)} C/min`;
+    }
+
+    function tempToColor(value, min, max) {
+        const span = Math.max(max - min, 1);
+        const ratio = Math.min(1, Math.max(0, (value - min) / span));
+        const hue = (1 - ratio) * 210;
+        const sat = 88;
+        const light = 34 + ratio * 26;
+        return `hsl(${hue}, ${sat}%, ${light}%)`;
+    }
+
+    function updateStatusPill(status) {
+        const pill = document.getElementById('status-pill');
+        pill.className = `tm-status-pill ${statusClass(status)}`;
+        pill.textContent = (status || 'normal').toUpperCase();
+    }
+
+    function renderZoneLegend(zones) {
+        const container = document.getElementById('zone-legend');
+        if (!zones || zones.length === 0) {
+            container.innerHTML = '<div class="tm-zone tm-empty">当前未配置区域定义。</div>';
+            return;
+        }
+        container.innerHTML = zones.map((zone, index) => `
+            <div class="tm-zone">
+                <div class="d-flex align-items-center gap-2">
+                    <span class="tm-zone-swatch" style="background:${zoneColors[index % zoneColors.length]};"></span>
+                    <span>${zone.zone_name || zone.zone_id}</span>
+                </div>
+                <span class="tm-help">${zone.zone_id}</span>
+            </div>
+        `).join('');
+    }
+
+    function drawHeatmap(heatmap, zones, hotspots) {
+        const canvas = document.getElementById('heatmapCanvas');
+        const ctx = canvas.getContext('2d');
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        if (!heatmap || !heatmap.length || !heatmap[0].length) {
+            ctx.fillStyle = 'rgba(148, 163, 184, 0.6)';
+            ctx.font = '20px sans-serif';
+            ctx.fillText('尚未获得热场数据', 32, 48);
+            return;
+        }
+
+        const rows = heatmap.length;
+        const cols = heatmap[0].length;
+        const cellW = canvas.width / cols;
+        const cellH = canvas.height / rows;
+        let min = Infinity;
+        let max = -Infinity;
+
+        for (const row of heatmap) {
+            for (const value of row) {
+                min = Math.min(min, value);
+                max = Math.max(max, value);
+            }
+        }
+
+        for (let y = 0; y < rows; y += 1) {
+            for (let x = 0; x < cols; x += 1) {
+                ctx.fillStyle = tempToColor(heatmap[y][x], min, max);
+                ctx.fillRect(x * cellW, y * cellH, cellW + 1, cellH + 1);
+            }
+        }
+
+        ctx.strokeStyle = 'rgba(255,255,255,0.08)';
+        ctx.lineWidth = 1;
+        for (let x = 0; x <= cols; x += 8) {
+            ctx.beginPath();
+            ctx.moveTo(x * cellW, 0);
+            ctx.lineTo(x * cellW, canvas.height);
+            ctx.stroke();
+        }
+
+        (zones || []).forEach((zone, index) => {
+            const region = zone.region || [];
+            if (region.length !== 4) {
+                return;
+            }
+            const color = zoneColors[index % zoneColors.length];
+            const x = region[0] * canvas.width;
+            const y = region[1] * canvas.height;
+            const width = (region[2] - region[0]) * canvas.width;
+            const height = (region[3] - region[1]) * canvas.height;
+            ctx.strokeStyle = color;
+            ctx.lineWidth = 2;
+            ctx.setLineDash([8, 6]);
+            ctx.strokeRect(x, y, width, height);
+            ctx.setLineDash([]);
+            ctx.fillStyle = 'rgba(2, 6, 23, 0.72)';
+            ctx.fillRect(x + 10, y + 10, Math.max(100, zone.zone_name.length * 18), 28);
+            ctx.fillStyle = color;
+            ctx.font = '600 14px sans-serif';
+            ctx.fillText(zone.zone_name || zone.zone_id, x + 18, y + 29);
+        });
+
+        (hotspots || []).forEach((hotspot, index) => {
+            const x = hotspot.center[0] * canvas.width;
+            const y = hotspot.center[1] * canvas.height;
+            const severity = hotspot.severity || 'normal';
+            const color = severity === 'critical' ? '#fb7185' :
+                severity === 'alarm' ? '#f97316' :
+                severity === 'warning' ? '#fbbf24' : '#4ade80';
+
+            ctx.beginPath();
+            ctx.fillStyle = color;
+            ctx.arc(x, y, 9 + index, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.lineWidth = 2;
+            ctx.strokeStyle = 'rgba(255,255,255,0.92)';
+            ctx.stroke();
+
+            ctx.fillStyle = 'rgba(2, 6, 23, 0.82)';
+            ctx.fillRect(x + 12, y - 12, 110, 24);
+            ctx.fillStyle = '#f8fafc';
+            ctx.font = '600 13px sans-serif';
+            ctx.fillText(`${hotspot.temperature.toFixed(1)} C`, x + 18, y + 5);
+        });
+
+        ctx.fillStyle = 'rgba(2, 6, 23, 0.64)';
+        ctx.fillRect(12, canvas.height - 42, 176, 28);
+        ctx.fillStyle = '#cbd5e1';
+        ctx.font = '600 13px sans-serif';
+        ctx.fillText(`热场范围 ${min.toFixed(1)} C - ${max.toFixed(1)} C`, 20, canvas.height - 23);
+    }
+
+    function drawTrend() {
+        const canvas = document.getElementById('trendCanvas');
+        const ctx = canvas.getContext('2d');
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        if (simState.history.length < 2) {
+            ctx.fillStyle = 'rgba(148, 163, 184, 0.6)';
+            ctx.font = '18px sans-serif';
+            ctx.fillText('执行至少两次推演后显示温度轨迹', 26, 42);
+            return;
+        }
+
+        const padding = { top: 24, right: 24, bottom: 28, left: 36 };
+        const values = simState.history.map(item => item.maxTemp);
+        const min = Math.min(...values) - 2;
+        const max = Math.max(...values) + 2;
+        const width = canvas.width - padding.left - padding.right;
+        const height = canvas.height - padding.top - padding.bottom;
+
+        ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
+        ctx.lineWidth = 1;
+        for (let i = 0; i < 4; i += 1) {
+            const y = padding.top + (height / 3) * i;
+            ctx.beginPath();
+            ctx.moveTo(padding.left, y);
+            ctx.lineTo(canvas.width - padding.right, y);
+            ctx.stroke();
+        }
+
+        ctx.strokeStyle = '#38bdf8';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        values.forEach((value, index) => {
+            const x = padding.left + (width / (values.length - 1)) * index;
+            const y = padding.top + height - ((value - min) / Math.max(max - min, 1)) * height;
+            if (index === 0) {
+                ctx.moveTo(x, y);
+            } else {
+                ctx.lineTo(x, y);
+            }
+        });
+        ctx.stroke();
+
+        values.forEach((value, index) => {
+            const x = padding.left + (width / (values.length - 1)) * index;
+            const y = padding.top + height - ((value - min) / Math.max(max - min, 1)) * height;
+            ctx.fillStyle = '#f97316';
+            ctx.beginPath();
+            ctx.arc(x, y, 4.5, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.fillStyle = '#cbd5e1';
+            ctx.font = '12px sans-serif';
+            ctx.fillText(`${Math.round(value)}C`, x - 14, y - 10);
+        });
+    }
