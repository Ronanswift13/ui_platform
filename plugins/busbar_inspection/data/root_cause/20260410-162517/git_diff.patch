+// ============================================================
+// 全局状态
+// ============================================================
+let currentMode = 'sim';       // 'sim' | 'live'
+let autoRunTimer = null;
+let autoRunInterval = 1500;    // ms
+let totalDefects = 0;
+let totalFrames = 0;
+
+const canvas = document.getElementById('sim-canvas');
+const ctx = canvas.getContext('2d');
+
+// ============================================================
+// 模式切换
+// ============================================================
+function switchMode(mode) {
+    currentMode = mode;
+    document.getElementById('btn-mode-sim').classList.toggle('active', mode === 'sim');
+    document.getElementById('btn-mode-live').classList.toggle('active', mode === 'live');
+    document.getElementById('panel-sim-view').style.display = mode === 'sim' ? '' : 'none';
+    document.getElementById('panel-live-view').style.display = mode === 'live' ? '' : 'none';
+    document.getElementById('panel-scenarios').style.display = mode === 'sim' ? '' : 'none';
+    document.getElementById('mode-badge').textContent = mode === 'sim' ? 'SIM' : 'LIVE';
+    document.getElementById('mode-badge').className = mode === 'sim' ? 'sim-badge' : 'sim-badge live-badge';
+
+    if (mode === 'live') stopAutoRun();
+}
+
+// ============================================================
+// 场景管理
+// ============================================================
+async function loadScenarios() {
+    try {
+        const resp = await fetch('/api/simulator/scenarios');
+        const data = await resp.json();
+        const list = document.getElementById('scenario-list');
+        list.innerHTML = '';
+
+        for (const s of data.scenarios) {
+            const tags = [];
+            if (s.has_defects) tags.push('<span class="scenario-tag tag-defect">缺陷</span>');
+            if (s.quality_issue) tags.push('<span class="scenario-tag tag-quality">质量</span>');
+            if (s.zoom_needed) tags.push('<span class="scenario-tag tag-zoom">变焦</span>');
+            if (!s.has_defects && !s.quality_issue) tags.push('<span class="scenario-tag tag-normal">正常</span>');
+
+            const card = document.createElement('div');
+            card.className = 'scenario-card';
+            card.dataset.id = s.scenario_id;
+            card.innerHTML = `
+                <div class="scenario-name">${s.name}</div>
+                <div class="scenario-desc">${s.description}</div>
+                <div>${tags.join(' ')}</div>
+            `;
+            card.onclick = () => selectScenario(s.scenario_id, s.name);
+            list.appendChild(card);
+        }
+    } catch (e) {
+        console.error('Failed to load scenarios:', e);
+    }
+}
+
+async function selectScenario(id, name) {
+    try {
+        await fetch(`/api/simulator/load?scenario_id=${encodeURIComponent(id)}`, { method: 'POST' });
+        document.querySelectorAll('.scenario-card').forEach(c => {
+            c.classList.toggle('active', c.dataset.id === id);
+        });
+        document.getElementById('scenario-label').textContent = name;
+        // 立即执行一步
+        await simStep();
+    } catch (e) {
+        console.error('Failed to load scenario:', e);
+    }
+}
+
+// ============================================================
+// 仿真控制
+// ============================================================
+async function simStep() {
+    const statusEl = document.getElementById('detect-status');
+    statusEl.textContent = 'Running';
+    statusEl.className = 'metric-value status-warning';
+
+    try {
+        // 并行获取帧图像和检测结果
+        const [frameResp, resultResp] = await Promise.all([
+            fetch('/api/simulator/frame_with_annotations'),
+            fetch('/api/simulator/step', { method: 'POST' }),
+        ]);
+
+        // 渲染帧
+        if (frameResp.ok && frameResp.headers.get('content-type')?.includes('image')) {
+            const blob = await frameResp.blob();
+            const url = URL.createObjectURL(blob);
+            const img = new Image();
+            img.onload = () => {
+                canvas.width = img.width;
+                canvas.height = img.height;
+                ctx.drawImage(img, 0, 0);
+                URL.revokeObjectURL(url);
+            };
+            img.src = url;
+        }
+
+        // 更新结果
+        if (resultResp.ok) {
+            const data = await resultResp.json();
+            updateResults(data);
+        }
+
+        statusEl.textContent = 'Ready';
+        statusEl.className = 'metric-value status-normal';
+    } catch (e) {
+        statusEl.textContent = 'Error';
+        statusEl.className = 'metric-value status-alarm';
+        console.error('Sim step error:', e);
+    }
+}
+
+function toggleAutoRun() {
+    document.getElementById('btn-auto').style.display = 'none';
+    document.getElementById('btn-stop').style.display = '';
+    autoRunTimer = setInterval(simStep, autoRunInterval);
+}
+
+function stopAutoRun() {
+    if (autoRunTimer) {
+        clearInterval(autoRunTimer);
+        autoRunTimer = null;
+    }
+    document.getElementById('btn-auto').style.display = '';
+    document.getElementById('btn-stop').style.display = 'none';
+}
+
+// ============================================================
+// 结果更新
+// ============================================================
+function updateResults(data) {
+    totalFrames++;
+    document.getElementById('frame-count').textContent = totalFrames;
+    document.getElementById('process-time').innerHTML =
+        `${data.processing_time_ms?.toFixed(1) || 0}<span style="font-size:0.9rem">ms</span>`;
+
+    // 缺陷计数
+    const newDefects = (data.detections || []).filter(d => d.label !== 'quality_failed').length;
+    totalDefects += newDefects;
+    document.getElementById('defect-count').textContent = totalDefects;
+
+    // 检测结果列表
+    const resultList = document.getElementById('result-list');
+    if (data.detections && data.detections.length > 0) {
+        resultList.innerHTML = data.detections.map(d => {
+            const labelClass = `label-${d.label}`;
+            const icon = d.label === 'quality_failed' ? 'bi-shield-exclamation' :
+                         d.label === 'pin_missing' ? 'bi-circle' :
+                         d.label === 'crack' ? 'bi-lightning' : 'bi-exclamation-diamond';
+            const desc = d.description || d.metadata?.reason || d.label;
+            return `
+                <div class="result-item">
+                    <div class="result-label ${labelClass}">
+                        <i class="bi ${icon}"></i> ${desc}
+                    </div>
+                    <div style="font-size:0.72rem; color:var(--text-secondary);">
+                        置信度: ${(d.confidence * 100).toFixed(1)}%
+                        ${d.severity ? ` | 严重度: ${d.severity}` : ''}
+                        ${d.failure_reason ? ` | 原因码: ${d.failure_reason}` : ''}
+                    </div>
+                </div>
+            `;
+        }).join('');
+    } else {
+        resultList.innerHTML = '<div class="text-secondary" style="font-size:0.82rem; padding:0.5rem;">本帧无检测结果</div>';
+    }
+
+    // 告警列表
+    const alarmList = document.getElementById('alarm-list');
+    if (data.alarms && data.alarms.length > 0) {
+        alarmList.innerHTML = data.alarms.map(a => `
+            <div class="alarm-item alarm-${a.level}">
+                <strong>${a.title}</strong>
+                <div style="font-size:0.72rem; margin-top:2px;">${a.message}</div>
+            </div>
+        `).join('');
+    } else {
+        alarmList.innerHTML = '<div class="text-secondary" style="font-size:0.82rem; padding:0.5rem;">暂无告警</div>';
+    }
+
+    // 图像质量
+    const stats = data.stats || {};
+    const q = stats.quality || {};
+    const clarity = q.clarity_score ?? 0;
+    document.getElementById('q-clarity').textContent = (clarity * 100).toFixed(1) + '%';
+    const clarityBar = document.getElementById('q-clarity-bar');
+    clarityBar.style.width = (clarity * 100) + '%';
+    clarityBar.style.background = clarity > 0.6 ? '#22c55e' : clarity > 0.35 ? '#f59e0b' : '#ef4444';
+    document.getElementById('q-overexposed').textContent = q.is_overexposed ? 'YES' : 'NO';
+    document.getElementById('q-overexposed').style.color = q.is_overexposed ? '#ef4444' : '#22c55e';
+    document.getElementById('q-lowcontrast').textContent = q.is_low_contrast ? 'YES' : 'NO';
+    document.getElementById('q-lowcontrast').style.color = q.is_low_contrast ? '#f59e0b' : '#22c55e';
+    document.getElementById('q-occluded').textContent = q.is_occluded ? 'YES' : 'NO';
+    document.getElementById('q-occluded').style.color = q.is_occluded ? '#ef4444' : '#22c55e';
+
+    // 变焦建议
+    const z = stats.zoom || {};
+    document.getElementById('z-zoom').textContent = (z.suggested_zoom || 1.0).toFixed(1) + 'x';
+    const action = z.suggested_action || 'NONE';
+    document.getElementById('z-action').textContent = action;
+    document.getElementById('z-action').style.color =
+        action === 'NONE' ? '#22c55e' :
+        action === 'ZOOM_IN' ? '#3b82f6' : '#f59e0b';
+}
+
+// ============================================================
+// 真实检测 (Live 模式)
+// ============================================================
+const imageUpload = document.getElementById('image-upload');
+if (imageUpload) {
+    imageUpload.addEventListener('change', function(e) {
+        const file = e.target.files[0];
+        if (!file) return;
+        const reader = new FileReader();
+        reader.onload = function(ev) {
+            const img = document.getElementById('detection-image');
+            img.src = ev.target.result;
+            img.style.display = 'block';
+            document.getElementById('canvas-placeholder').style.display = 'none';
+        };
+        reader.readAsDataURL(file);
+    });
+}
+
+async function runRealDetection() {
+    const fileInput = document.getElementById('image-upload');
+    if (!fileInput.files || !fileInput.files[0]) {
+        alert('请先上传一张图像');
+        return;
     }
+
+    const statusEl = document.getElementById('detect-status');
+    statusEl.textContent = 'Running';
+    statusEl.className = 'metric-value status-warning';
+
+    try {
+        const formData = new FormData();
+        formData.append('file', fileInput.files[0]);
+
+        const resp = await fetch('/api/detect', { method: 'POST', body: formData });
+        if (resp.ok) {
+            const data = await resp.json();
+            // 适配真实检测返回格式
+            const adapted = {
+                detections: (data.results || []).map(r => ({
+                    label: r.label,
+                    confidence: r.confidence,
+                    bbox: r.bbox,
+                    description: r.label,
+                    failure_reason: r.failure_reason,
+                    metadata: r.metadata || {},
+                })),
+                alarms: (data.alarms || []).map(a => ({
+                    level: a.level,
+                    title: a.title,
+                    message: a.message,
+                })),
+                processing_time_ms: data.processing_time_ms || 0,
+                stats: {
+                    quality: data.results?.[0]?.metadata?.quality || {},
+                    zoom: {
+                        suggested_zoom: data.results?.[0]?.metadata?.suggested_zoom || 1.0,
+                        suggested_action: data.results?.[0]?.metadata?.suggested_action || 'NONE',
+                    },
+                },
+            };
+            updateResults(adapted);
+        }
+        statusEl.textContent = 'Ready';
+        statusEl.className = 'metric-value status-normal';
+    } catch (e) {
+        statusEl.textContent = 'Error';
+        statusEl.className = 'metric-value status-alarm';
+        console.error('Detection error:', e);
+    }
+}
+
+// ============================================================
+// 初始化
+// ============================================================
+document.addEventListener('DOMContentLoaded', () => {
+    loadScenarios();
+    // 渲染初始画布
+    ctx.fillStyle = '#0a0b0d';
+    ctx.fillRect(0, 0, canvas.width, canvas.height);
+    ctx.fillStyle = '#3b3f4a';
+    ctx.font = '16px sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('选择仿真场景后点击"单步"或"自动运行"', canvas.width / 2, canvas.height / 2);
+});
 </script>
