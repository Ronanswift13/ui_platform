+
+        $('metric-frame-count').textContent = status.frame_count || 0;
+        $('metric-device-count').textContent = status.registered_devices || Object.keys(payload.devices || {}).length;
+        $('metric-subsidence-count').textContent = status.subsidence_points || Object.keys(payload.subsidence || {}).length;
+        $('metric-map-resolution').textContent = status.map_resolution ? `${status.map_resolution}m` : '--';
+        $('metric-scene-mode').textContent = simulated
+            ? '仿真模式使用独立插件实例推进'
+            : '真实模式只读当前插件状态';
+        $('metric-frame-hint').textContent = simulated
