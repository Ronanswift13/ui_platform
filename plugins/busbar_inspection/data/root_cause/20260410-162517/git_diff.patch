+    }
+
+    async function refreshRealMonitor() {
+        const status = await fetchJson('/api/status');
+        renderPayload(normalizeRealPayload(status));
+    }
+
+    function normalizeRealPayload(data) {
+        const pose = data.current_pose || {};
+        return {
+            success: true,
+            mode: 'real_monitor',
+            runtime: {
+                updated_at: new Date().toLocaleTimeString('zh-CN', { hour12: false }),
+                description: '真实监测模式只读取插件当前状态，不加载任何 standalone 仿真点云。',
+            },
+            scenario: {
+                id: 'real_monitor',
+                name: '真实监测模式',
+                summary: '当前只展示插件状态快照；等待总 UI 或真实数据源接入。',
+                station_area: '真实工程链路',
+                voltage_level: '--',
+                focus: '不向真实算法回灌仿真结果，只做状态观测。',
+            },
+            status: {
+                frame_count: data.frame_count || 0,
+                registered_devices: data.registered_devices || 0,
+                subsidence_points: data.subsidence_points || 0,
+                map_resolution: data.map_resolution,
+                map_size: data.map_size || [],
+                pose_history_length: data.pose_history_length || 0,
+                current_pose: {
+                    x: pose.x || 0,
+                    y: pose.y || 0,
+                    z: pose.z || 0,
+                    roll: pose.roll || 0,
+                    pitch: pose.pitch || 0,
+                    yaw: pose.yaw || 0,
+                },
+                dl_enabled: !!data.dl_enabled,
+                initialized: !!data.initialized,
+            },
+            latest_result: {
+                processed_points: 0,
+                ground_points: 0,
+                object_points: 0,
+                detected_objects: 0,
+                registration_error: null,
+            },
+            devices: data.devices || {},
+            subsidence: data.subsidence || {},
+            alerts: [],
+            point_cloud: { sensor_points: [] },
+            map_preview: null,
+            sensor_track: [],
+            current_sensor_pose: {
+                x: pose.x || 0,
+                y: pose.y || 0,
+                z: pose.z || 0,
+                yaw: pose.yaw || 0,
+            },
+            history: [],
+        };
+    }
+
+    function renderPayload(payload) {
+        if (!payload || !payload.success) return;
+        const simulated = payload.mode === 'simulated';
+        const status = payload.status || {};
+        const pose = status.current_pose || {};
+        const result = payload.latest_result || {};
+
+        $('runtime-updated-at').textContent = payload.runtime && payload.runtime.updated_at
+            ? `更新时间 ${formatTime(payload.runtime.updated_at)}`
+            : '等待更新';
