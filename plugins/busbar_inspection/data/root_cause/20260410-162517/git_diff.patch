+
+        function renderMetrics(view) {
+            $('conf-threshold').textContent = formatConfidence(view.controls ? view.controls.confidenceThreshold : readNumber('cfg-conf-threshold', 0.45));
+
+            if (view.mode === 'simulated') {
+                $('inference-count').textContent = String(runtime.simulation.framesProcessed);
+                $('error-count').textContent = String(view.hiddenResults.length);
+                setStatusAppearance(view.interlocks.length ? 'Simulated' : 'Simulation', view.interlocks.length ? 'warning' : 'normal');
+                $('stat-fps').textContent = runtime.simulation.running ? '0.6' : '0';
+                $('stat-frames').textContent = String(runtime.simulation.framesProcessed);
+                $('stat-detections').textContent = String(runtime.simulation.detections);
+                $('stat-alarms').textContent = String(runtime.simulation.alarms);
+                $('stat-avg-time').textContent = runtime.simulation.framesProcessed
