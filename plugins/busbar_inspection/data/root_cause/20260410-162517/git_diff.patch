+    }
+
+    async function loadScenario(id) {
+        const payload = await fetchJson(`/api/simulator/load?scenario_id=${encodeURIComponent(id)}`, {
+            method: 'POST',
+        });
+        runtime.lastPayload = payload;
+        renderPayload(payload);
+    }
+
+    async function stepSimulation() {
+        const payload = await fetchJson('/api/simulator/step', { method: 'POST' });
+        runtime.lastPayload = payload;
