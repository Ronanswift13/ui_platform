+            : '当前帧数来自真实插件状态快照';
+
+        $('map-caption').textContent = simulated
+            ? `${payload.scenario.station_area} / ${payload.scenario.voltage_level}`
+            : '真实模式下不渲染仿真占据图';
+        $('cloud-caption').textContent = simulated
+            ? `frame ${result.frame_id || 0} / processed ${result.processed_points || 0}`
+            : '真实模式下仅保留空画布占位';
+
+        renderStatusList(status, pose, result);
+        renderDeviceList(payload.devices || {});
+        renderSubsidenceList(payload.subsidence || {}, payload.alerts || []);
+        renderSceneDetail(payload, simulated);
+        drawMap(payload);
+        drawCloud(payload);
+    }
+
+    function renderStatusList(status, pose, result) {
+        const rows = [
+            ['算法姿态', `x=${toFixed(pose.x)} y=${toFixed(pose.y)} z=${toFixed(pose.z)}`],
+            ['姿态角', `roll=${toDeg(pose.roll)} pitch=${toDeg(pose.pitch)} yaw=${toDeg(pose.yaw)}`],
+            ['点云统计', `processed=${result.processed_points || 0} ground=${result.ground_points || 0}`],
+            ['目标聚类', `objects=${result.detected_objects || 0} non_ground=${result.object_points || 0}`],
+            ['配准误差', result.registration_error == null ? '--' : Number(result.registration_error).toFixed(4)],
+            ['轨迹历史', `${status.pose_history_length || 0} 个关键帧 / DL ${status.dl_enabled ? 'on' : 'off'}`],
+        ];
+        $('status-list').innerHTML = rows.map(([name, value]) => (
+            `<div class="status-row"><span class="status-name">${name}</span><span class="status-value">${value}</span></div>`
+        )).join('');
+    }
+
+    function renderDeviceList(devices) {
+        const ids = Object.keys(devices || {});
+        if (!ids.length) {
+            showInlineMessage('device-list', '当前没有挂载到地图的设备锚点。');
+            return;
+        }
+        $('device-list').innerHTML = ids.map((id) => {
+            const device = devices[id];
+            const loc = device.location || {};
+            return `
+                <div class="device-item">
+                    <strong>${id}</strong>
+                    <div class="device-meta">${device.metadata && device.metadata.label ? device.metadata.label : '设备锚点'} / ${device.type || 'unknown'}</div>
+                    <div class="device-meta">(${toFixed(loc.x, 1)}, ${toFixed(loc.y, 1)}, ${toFixed(loc.z, 1)})</div>
+                </div>
+            `;
+        }).join('');
+    }
+
+    function renderSubsidenceList(subsidence, alerts) {
+        const ids = Object.keys(subsidence || {});
+        if (!ids.length) {
+            showInlineMessage('subsidence-list', '当前没有沉降监测点。');
+        } else {
+            $('subsidence-list').innerHTML = ids.map((id) => {
+                const point = subsidence[id];
+                const sub = Number(point.subsidence_mm || 0);
+                const cls = Math.abs(sub) >= 10 ? 'severity-alert' : Math.abs(sub) >= 5 ? 'severity-warn' : 'severity-ok';
+                return `
+                    <div class="subsidence-item">
+                        <strong>${id}</strong>
+                        <div class="subsidence-meta ${cls}">沉降量 ${sub.toFixed(2)} mm</div>
+                        <div class="subsidence-meta">初始高程 ${toFixed(point.initial_height)} m / 当前 ${toFixed(point.current_height)} m</div>
+                    </div>
+                `;
+            }).join('');
+        }
+
+        if (!alerts || !alerts.length) {
+            showInlineMessage('alert-list', '当前没有超过阈值的沉降告警。');
+            return;
+        }
+        $('alert-list').innerHTML = alerts.map((alert) => `
+            <div class="alert-item">
+                <strong>${alert.point_id} / ${alert.level === 'alert' ? '告警' : '预警'}</strong>
+                <div class="alert-meta">${alert.message}</div>
+            </div>
+        `).join('');
+    }
+
+    function renderSceneDetail(payload, simulated) {
+        const items = [];
+        if (payload.scenario && payload.scenario.summary) {
+            items.push(`<div><strong>场景摘要：</strong>${payload.scenario.summary}</div>`);
+        }
+        if (payload.runtime && payload.runtime.description) {
+            items.push(`<div><strong>模式说明：</strong>${payload.runtime.description}</div>`);
+        }
+        if (simulated && payload.history && payload.history.length) {
+            const latest = payload.history[payload.history.length - 1];
+            items.push(`<div><strong>最近一帧：</strong>processed ${latest.processed_points || 0} / objects ${latest.detected_objects || 0}</div>`);
+        } else {
+            items.push('<div><strong>真实模式：</strong>真实监测模式只读取插件当前状态，不把仿真结果写回真实建图链路。</div>');
+        }
+        $('scene-detail').innerHTML = items.join('');
+    }
+
+    function drawMap(payload) {
+        const canvas = $('map-canvas');
+        const ctx = canvas.getContext('2d');
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.fillStyle = '#07111d';
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        if (!payload.map_preview || !payload.map_preview.grid) {
+            drawPlaceholder(ctx, canvas, '真实监测模式只读取插件当前状态，俯视图保持占位。');
+            return;
+        }
+
+        const grid = payload.map_preview.grid;
+        const rows = grid.length;
+        const cols = rows ? grid[0].length : 0;
+        const margin = 36;
+        const drawWidth = canvas.width - margin * 2;
+        const drawHeight = canvas.height - margin * 2;
+
+        ctx.save();
+        ctx.translate(margin, margin);
+        for (let y = 0; y < rows; y += 1) {
+            for (let x = 0; x < cols; x += 1) {
+                const value = grid[y][x];
+                if (!value || value < 0.02) continue;
+                ctx.fillStyle = `rgba(101, 200, 255, ${Math.min(0.9, value + 0.05)})`;
+                ctx.fillRect(
+                    (x / Math.max(cols, 1)) * drawWidth,
+                    (y / Math.max(rows, 1)) * drawHeight,
+                    Math.ceil(drawWidth / Math.max(cols, 1)),
+                    Math.ceil(drawHeight / Math.max(rows, 1))
+                );
+            }
+        }
+
+        drawTrack(ctx, drawWidth, drawHeight, payload.map_preview.world_bounds, payload.sensor_track || [], payload.current_sensor_pose || {});
+        drawDeviceAnchors(ctx, drawWidth, drawHeight, payload.map_preview.world_bounds, payload.devices || {});
+        ctx.restore();
+    }
+
+    function drawTrack(ctx, width, height, bounds, track, currentPose) {
+        if (!bounds || !track || !track.length) return;
+        ctx.strokeStyle = 'rgba(67, 240, 213, 0.9)';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        track.forEach((pose, index) => {
+            const point = worldToCanvas(bounds, pose, width, height);
+            if (index === 0) ctx.moveTo(point.x, point.y);
+            else ctx.lineTo(point.x, point.y);
+        });
+        ctx.stroke();
+
+        const current = worldToCanvas(bounds, currentPose, width, height);
+        ctx.fillStyle = '#43f0d5';
+        ctx.beginPath();
+        ctx.arc(current.x, current.y, 7, 0, Math.PI * 2);
+        ctx.fill();
+    }
+
+    function drawDeviceAnchors(ctx, width, height, bounds, devices) {
+        Object.keys(devices).forEach((id) => {
+            const device = devices[id];
+            const loc = device.location || {};
+            const point = worldToCanvas(bounds, loc, width, height);
+            ctx.fillStyle = '#f9b562';
+            ctx.beginPath();
+            ctx.arc(point.x, point.y, 4.5, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.fillStyle = '#dce9f7';
+            ctx.font = '12px monospace';
+            ctx.fillText(id, point.x + 8, point.y - 6);
+        });
+    }
+
+    function worldToCanvas(bounds, point, width, height) {
+        const minX = bounds.min_x;
+        const maxX = bounds.max_x;
+        const minY = bounds.min_y;
+        const maxY = bounds.max_y;
+        return {
+            x: ((point.x - minX) / Math.max(maxX - minX, 1e-6)) * width,
+            y: height - ((point.y - minY) / Math.max(maxY - minY, 1e-6)) * height,
+        };
+    }
+
+    function drawCloud(payload) {
+        const canvas = $('cloud-canvas');
+        const ctx = canvas.getContext('2d');
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.fillStyle = '#07111d';
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        const points = payload.point_cloud && payload.point_cloud.sensor_points ? payload.point_cloud.sensor_points : [];
+        if (!points.length) {
+            drawPlaceholder(ctx, canvas, '真实监测模式只读取插件当前状态，不注入仿真点云。');
+            return;
+        }
+
+        const xs = points.map((pt) => pt[0]);
+        const zs = points.map((pt) => pt[2]);
+        const minX = Math.min(...xs);
+        const maxX = Math.max(...xs);
+        const minZ = Math.min(...zs);
+        const maxZ = Math.max(...zs);
+
+        points.forEach((pt) => {
+            const x = 48 + ((pt[0] - minX) / Math.max(maxX - minX, 1e-6)) * (canvas.width - 96);
+            const y = canvas.height - 42 - ((pt[2] - minZ) / Math.max(maxZ - minZ, 1e-6)) * (canvas.height - 84);
+            const alpha = 0.25 + Math.min(0.65, Math.abs(pt[1]) / 24);
+            ctx.fillStyle = `rgba(101, 200, 255, ${alpha})`;
+            ctx.beginPath();
+            ctx.arc(x, y, 2.1, 0, Math.PI * 2);
+            ctx.fill();
+        });
+
+        ctx.fillStyle = 'rgba(220, 233, 247, 0.72)';
+        ctx.font = '12px monospace';
+        ctx.fillText('x-z 局部截面 / 颜色随横向偏移增强', 20, 24);
+    }
+
+    function drawPlaceholder(ctx, canvas, message) {
+        ctx.fillStyle = 'rgba(148, 163, 184, 0.84)';
+        ctx.font = '16px sans-serif';
+        ctx.textAlign = 'center';
+        ctx.fillText(message, canvas.width / 2, canvas.height / 2);
+        ctx.textAlign = 'start';
+    }
+
+    function toFixed(value, digits = 3) {
+        return Number(value || 0).toFixed(digits);
+    }
+
+    function toDeg(value) {
+        return `${(Number(value || 0) * 180 / Math.PI).toFixed(2)}°`;
+    }
+
+    function formatTime(value) {
+        const date = new Date(value);
+        if (Number.isNaN(date.getTime())) return value;
+        return date.toLocaleTimeString('zh-CN', { hour12: false });
+    }
+
+    window.updateDashboard = function(data) {
+        if (runtime.mode !== 'real_monitor') return;
+        renderPayload(normalizeRealPayload(data));
+    };
+
+    $('btn-mode-simulated').addEventListener('click', () => setMode('simulated'));
+    $('btn-mode-real').addEventListener('click', () => setMode('real_monitor'));
+    $('btn-play-sim').addEventListener('click', togglePlayback);
+    $('btn-step-sim').addEventListener('click', () => stepSimulation().catch(console.error));
+    $('btn-reset-sim').addEventListener('click', () => resetSimulation().catch(console.error));
+    $('scenario-select').addEventListener('change', (event) => {
+        loadScenario(event.target.value).catch(console.error);
+    });
+
+    loadScenarios().catch((error) => {
+        console.error(error);
+        showInlineMessage('scene-detail', '独立仿真场景加载失败，请查看控制台日志。');
+    });
+})();
 </script>
