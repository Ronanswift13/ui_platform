+        }
+
+        function startSimulation() {
+            if (runtime.mode !== 'simulated') {
+                return;
+            }
+            if (runtime.simulation.running) {
+                stopSimulation();
+                return;
+            }
+            runtime.simulation.running = true;
+            updateSimulationButton();
+            presentSimulationFrame(true);
