{
    "id": "indoor_fence",
    "name": "室内电子围栏插件",
    "version": "2.1.0",
    "description": "基于视觉+2D激光雷达融合的室内电子围栏系统，支持多人跟踪、越线检测、授权校验和独立运维",
    "author": "G组",
    "category": "indoor",
    "entrypoint": "plugin.py",
    "plugin_class": "IndoorFencePlugin",
    "capabilities": [
        "person_detection",
        "multi_target_tracking",
        "zone_intrusion",
        "authorization_check",
        "lidar_fence"
    ],
    "device_types": [
        "cabinet",
        "indoor_area",
        "passage",
        "safety_zone"
    ],
    "dependencies": [
        "numpy",
        "opencv-python",
        "pydantic",
        "pyyaml"
    ],
    "min_platform_version": "1.0.0",
    "config_schema": {
        "type": "object",
        "properties": {
            "model": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "device": {"type": "string", "enum": ["cpu", "cuda"]},
                    "input_size": {"type": "array", "items": {"type": "integer"}}
                }
            },
            "inference": {
                "type": "object",
                "properties": {
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "nms_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "tracking_enabled": {"type": "boolean"},
                    "max_track_age": {"type": "integer", "minimum": 1}
                }
            },
            "tracking": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "max_age": {"type": "integer", "minimum": 1},
                    "min_hits": {"type": "integer", "minimum": 1},
                    "distance_threshold": {"type": "number", "minimum": 0.01},
                    "use_kalman": {"type": "boolean"}
                }
            },
            "lidar": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "device_ip": {"type": "string"},
                    "device_port": {"type": "integer"},
                    "scan_rate_hz": {"type": "number"},
                    "angle_min_deg": {"type": "number"},
                    "angle_max_deg": {"type": "number"},
                    "angle_offset_deg": {"type": "number"},
                    "install": {
                        "type": "object",
                        "properties": {
                            "height_m": {"type": "number"},
                            "tilt_deg": {"type": "number"}
                        }
                    }
                }
            },
            "camera": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "source": {"type": "string"},
                    "resolution": {"type": "array", "items": {"type": "integer"}},
                    "fps": {"type": "integer", "minimum": 1},
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "nms_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "model_path": {"type": "string"},
                    "height_m": {"type": "number"},
                    "tilt_deg": {"type": "number"}
                }
            },
            "safety_zone": {
                "type": "object",
                "properties": {
                    "yellow_line_distance_m": {"type": "number"},
                    "warning_distance_m": {"type": "number"},
                    "danger_distance_m": {"type": "number"}
                }
            },
            "cabinet_authorization": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "allow_list": {"type": "array", "items": {"type": "integer"}},
                    "check_multi_person": {"type": "boolean"},
                    "max_persons_per_cabinet": {"type": "integer", "minimum": 1}
                }
            },
            "fusion": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "max_time_diff_ms": {"type": "number"},
                    "angle_match_threshold_deg": {"type": "number"},
                    "distance_match_threshold_m": {"type": "number"}
                }
            },
            "light": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "output_type": {"type": "string"}
                }
            },
            "audit": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "log_level": {"type": "string", "enum": ["frame", "event"]},
                    "log_dir": {"type": "string"}
                }
            },
            "zone_config": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "persist_on_update": {"type": "boolean"}
                }
            }
        }
    }
}
