{
    "id": "switch_inspection",
    "name": "开关间隔自主巡视插件",
    "version": "1.0.0",
    "description": "分合位状态识别、五防逻辑校验、图像清晰度评价",
    "author": "B组",
    "category": "outdoor",
    "entrypoint": "plugin.py",
    "plugin_class": "SwitchInspectionPlugin",
    "capabilities": [
        "state_recognition",
        "image_quality"
    ],
    "verified_capabilities": [
        "state_recognition"
    ],
    "experimental_capabilities": [
        "image_quality"
    ],
    "blocked_capabilities": [
        "five_prevention_logic_validation"
    ],
    "required_fixtures": [
        "switch_open_sample.jpg",
        "switch_closed_sample.jpg",
        "isolator_state_sample.jpg"
    ],
    "runtime_mode_support": {
        "real_dl": false,
        "traditional_fallback": true,
        "simulation": true
    },
    "current_known_limits": [
        "无真实图像回放数据集",
        "YOLOv8-ViT 模型为可选导入，当前环境不可用",
        "五防逻辑校验代码存在但未接入主插件链路",
        "SF6 表计读数默认关闭",
        "switch_consistency.py 为独立模块，有测试但不自动集成",
        "image_quality 仅有契约测试，无真实清晰度评价回归"
    ],
    "device_types": [
        "breaker",
        "isolator",
        "grounding"
    ],
    "dependencies": [
        "numpy",
        "opencv-python"
    ],
    "min_platform_version": "1.0.0",
    "config_schema": {
        "type": "object",
        "properties": {
            "model": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "device": {"type": "string", "enum": ["cpu", "cuda"]}
                }
            },
            "inference": {
                "type": "object",
                "properties": {
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "nms_threshold": {"type": "number", "minimum": 0, "maximum": 1}
                }
            },
            "state_recognition": {
                "type": "object",
                "properties": {
                    "switch_states": {"type": "array", "items": {"type": "string"}},
                    "logic_validation": {"type": "object"}
                }
            },
            "image_quality": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "min_clarity_score": {"type": "number"}
                }
            }
        }
    }
}
