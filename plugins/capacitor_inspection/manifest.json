{
    "id": "capacitor_inspection",
    "name": "电容器自主巡视插件",
    "version": "1.0.0",
    "description": "电容器组结构完整性检测、倾斜/倒塌识别、区域入侵检测",
    "author": "D组",
    "category": "outdoor",
    "entrypoint": "plugin.py",
    "plugin_class": "CapacitorInspectionPlugin",
    "capabilities": [
        "defect_detection",
        "intrusion_detection"
    ],
    "verified_capabilities": [],
    "experimental_capabilities": [
        "defect_detection",
        "intrusion_detection"
    ],
    "blocked_capabilities": [
        "real_dl_onnx_inference"
    ],
    "required_fixtures": [
        "capacitor_tilt_sample.jpg",
        "capacitor_collapse_sample.jpg",
        "capacitor_intrusion_sample.jpg"
    ],
    "runtime_mode_support": {
        "real_dl": false,
        "traditional_fallback": true,
        "simulation": true
    },
    "current_known_limits": [
        "测试存在 import 错误(ModuleNotFoundError: detector_enhanced)，全部无法收集",
        "无 fixtures 目录，无 regression 目录",
        "intrusion 正向识别缺少真实样本回放证据",
        "传统 CV 降级链仍有硬编码阈值技术债",
        "YOLOv8-ViT 和 YOLOv8-OBB 均为可选导入，当前环境不可用"
    ],
    "device_types": [
        "capacitor_bank",
        "capacitor_unit",
        "fuse",
        "insulator"
    ],
    "dependencies": [
        "numpy",
        "opencv-python"
    ],
    "min_platform_version": "1.0.0",
    "config_schema": {
        "type": "object",
        "properties": {
            "model": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "device": {"type": "string", "enum": ["cpu", "cuda"]}
                }
            },
            "inference": {
                "type": "object",
                "properties": {
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "nms_threshold": {"type": "number", "minimum": 0, "maximum": 1}
                }
            },
            "structural_integrity": {
                "type": "object",
                "properties": {
                    "tilt_detection": {"type": "object"},
                    "collapse_detection": {"type": "object"},
                    "missing_parts": {"type": "array", "items": {"type": "string"}}
                }
            },
            "intrusion_detection": {
                "type": "object",
                "properties": {
                    "enabled": {"type": "boolean"},
                    "zone_types": {"type": "array", "items": {"type": "string"}},
                    "intrusion_targets": {"type": "array", "items": {"type": "string"}},
                    "alert_delay": {"type": "number"}
                }
            }
        }
    }
}
