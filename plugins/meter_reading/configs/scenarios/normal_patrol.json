            "range_max": 1.6,
            "initial_value": 0.8,
            "pattern": "sine",
            "speed": 0.5
        },
        {
            "id": "temp_B",
            "type": "analog",
            "label": "温度表 B",
            "unit": "°C",
            "range_min": -20,
            "range_max": 100,
            "initial_value": 45,
            "pattern": "sine",
            "speed": 0.3
        },
        {
            "id": "digital_C",
            "type": "digital",
            "label": "数字表 C",
            "unit": "kV",
            "range_min": 0,
            "range_max": 220,
            "initial_value": 110,
            "pattern": "sine",
            "speed": 0.4
        },
        {
            "id": "led_D",
            "type": "led",
            "label": "运行灯 D",
            "led_color": "green",
            "cycle": ["green", "green", "green", "green"],
            "speed": 1.0
        }
    ]
