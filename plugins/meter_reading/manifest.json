{
    "id": "meter_reading",
    "name": "表计无建模增强读数插件",
    "version": "1.0.0",
    "description": "任意角度表计读数、关键点检测透视矫正、自动量程识别、失败兜底策略",
    "author": "E组",
    "category": "indoor",
    "entrypoint": "plugin.py",
    "plugin_class": "MeterReadingPlugin",
    "capabilities": [
        "meter_reading"
    ],
    "verified_capabilities": [
        "output_structure_contract"
    ],
    "experimental_capabilities": [
        "analog_meter_reading",
        "digital_ocr_reading",
        "led_indicator_reading",
        "perspective_correction",
        "fallback_chain"
    ],
    "blocked_capabilities": [
        "real_dl_keypoint_inference",
        "real_dl_ocr_inference"
    ],
    "required_fixtures": [
        "meter_analog_normal_001.jpg",
        "meter_analog_boundary_001.jpg",
        "meter_analog_quality_fail_001.jpg",
        "meter_digital_display_001.jpg",
        "meter_led_indicator_green_001.fixture.json",
        "meter_glare_or_tilt_review_required_001.jpg"
    ],
    "runtime_mode_support": {
        "real_dl": false,
        "traditional_fallback": true,
        "simulation": true
    },
    "current_known_limits": [
        "插件测试已可收集并通过，但大多仍是契约/单元/合成测试",
        "当前 replay 只有一个 LED mock fixture 可执行，不能证明真实 LED 现场识别性能",
        "analog/digital/perspective 仅固定 planned 槽位，尚无 present_labeled 真实图像",
        "tests/regression/ 仍为空，真实标定样本回归尚未建立",
        "HRNet keypoint 模型和 CRNN OCR 模型为可选依赖，当前不可用",
        "analog/digital 的精度目标尚无 fixture 级回放验证"
    ],
    "replay_baseline": {
        "expected_results": "tests/replay/expected_results.json",
        "collection_status": "partial_assets_available",
        "verified_scope": [
            "output_structure_contract",
            "expected_results_schema",
            "mock_led_replay_runner"
        ],
        "experimental_scope": [
            "analog_meter_reading",
            "digital_ocr_reading",
            "led_indicator_real_image_reading",
            "perspective_correction",
            "fallback_chain"
        ]
    },
    "device_types": [
        "pressure_gauge",
        "temperature_gauge",
        "oil_level_gauge",
        "sf6_density_gauge",
        "digital_display",
        "led_indicator"
    ],
    "dependencies": [
        "numpy",
        "opencv-python"
    ],
    "min_platform_version": "1.0.0",
    "config_schema": {
        "type": "object",
        "properties": {
            "model": {
                "type": "object",
                "properties": {
                    "keypoint_model": {"type": "string"},
                    "ocr_model": {"type": "string"},
                    "device": {"type": "string", "enum": ["cpu", "cuda"]}
                }
            },
            "inference": {
                "type": "object",
                "properties": {
                    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
                    "perspective_correction": {"type": "boolean"},
                    "max_rotation_angle": {"type": "number"}
                }
            },
            "reading": {
                "type": "object",
                "properties": {
                    "auto_range": {"type": "boolean"},
                    "interpolation": {"type": "string"},
                    "decimal_places": {"type": "integer"},
                    "fallback": {"type": "object"}
                }
            },
            "preprocessing": {
                "type": "object",
                "properties": {
                    "enhance_lighting": {"type": "boolean"},
                    "anti_glare": {"type": "boolean"},
                    "contrast_enhancement": {"type": "number"}
                }
            }
        }
    }
}
