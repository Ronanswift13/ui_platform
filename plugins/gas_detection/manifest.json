{
    "id": "gas_detection",
    "name": "气体泄漏检测",
    "version": "1.0.0",
    "description": "基于时序预测模型的气体泄漏检测，支持SF6/H2/CO/C2H2等多种气体监测和趋势预测",
    "author": "AI巡检系统",
    "category": "monitoring",
    "enabled": true,
    
    "entrypoint": "plugin.py",
    "plugin_class": "GasDetectionPlugin",
    
    "capabilities": [
        "gas_concentration_monitoring",
        "leakage_detection"
    ],
    
    "models_required": [
        {
            "model_id": "sf6_forecast",
            "model_path": "models/timeseries/lstm_sf6_forecast.onnx",
            "description": "LSTM SF6浓度预测模型",
            "required": true
        },
        {
            "model_id": "multi_gas_forecast",
            "model_path": "models/timeseries/transformer_gas_forecast.onnx",
            "description": "Transformer多气体综合预测模型",
            "required": false
        },
        {
            "model_id": "equipment_health_trend",
            "model_path": "models/timeseries/health_trend.onnx",
            "description": "设备健康趋势预测模型",
            "required": false
        }
    ],
    
    "input_schema": {
        "type": "object",
        "properties": {
            "device_id": {
                "type": "string",
                "description": "设备ID"
            },
            "timestamp": {
                "type": "number",
                "description": "Unix时间戳"
            },
            "gas_readings": {
                "type": "object",
                "description": "气体读数 (ppm)",
                "properties": {
                    "SF6": {"type": "number"},
                    "H2": {"type": "number"},
                    "CO": {"type": "number"},
                    "C2H2": {"type": "number"},
                    "CH4": {"type": "number"},
                    "C2H4": {"type": "number"},
                    "C2H6": {"type": "number"}
                }
            },
            "environmental": {
                "type": "object",
                "description": "环境参数",
                "properties": {
                    "temperature": {"type": "number"},
                    "humidity": {"type": "number"},
                    "pressure": {"type": "number"}
                }
            }
        },
        "required": ["device_id", "gas_readings"]
    },
    
    "output_schema": {
        "type": "object",
        "properties": {
            "success": {"type": "boolean"},
            "status": {"type": "string"},
            "gas_status": {"type": "object"},
            "predictions": {"type": "object"},
            "leak_detection": {"type": "object"},
            "alarms": {"type": "array"}
        }
    },
    
    "default_config": {
        "history_length": 168,
        "prediction_horizon": 24,
        "sample_interval_seconds": 3600,
        "min_leak_rate": 5.0,
        "leak_detection_window": 20,
        "leak_confidence_threshold": 0.7
    },
    
    "supported_gases": ["SF6", "H2", "CO", "C2H2", "CH4", "C2H4", "C2H6"],
    
    "supported_voltage_levels": ["all"],
    
    "hardware_requirements": {
        "gas_sensors": true,
        "environmental_sensors": true
    },
    
    "dependencies": [
        "numpy",
        "onnxruntime"
    ],
    
    "tags": ["gas", "leakage", "monitoring", "prediction", "timeseries", "SF6", "DGA"]
}
