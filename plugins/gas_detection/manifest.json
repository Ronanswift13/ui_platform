{
  "id": "gas_detection",
  "name": "气体泄漏检测",
  "version": "1.0.0",
  "description": "基于规则阈值与占位趋势预测的气体泄漏检测，支持SF6/H2/CO/C2H2等多种气体监测",
  "author": "AI巡检系统",
  "category": "outdoor",
  "enabled": true,
  "entrypoint": "plugin.py",
  "plugin_class": "GasDetectionPlugin",
  "config_file": "configs/default.yaml",
  "capabilities": [
    "gas_concentration_monitoring",
    "leakage_detection",
    "anomaly_detection"
  ],
  "domain_capabilities": [
    "sensor_input",
    "time_series_monitoring",
    "standard_alarm_output",
    "trend_prediction_placeholder"
  ],
  "models_required": [
    {
      "model_id": "sf6_forecast",
      "model_path": "models/timeseries/lstm_sf6_forecast.onnx",
      "description": "LSTM SF6浓度预测模型",
      "required": false
    },
    {
      "model_id": "multi_gas_forecast",
      "model_path": "models/timeseries/transformer_gas_forecast.onnx",
      "description": "Transformer多气体综合预测模型",
      "required": false
    },
    {
      "model_id": "equipment_health_trend",
      "model_path": "models/timeseries/health_trend.onnx",
      "description": "设备健康趋势预测模型",
      "required": false
    }
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "device_id": {
        "type": "string"
      },
      "timestamp": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "format": "date-time"
          }
        ]
      },
      "readings": {
        "type": "object",
        "description": "统一气体读数壳，单位ppm"
      },
      "gas_readings": {
        "type": "object",
        "description": "兼容旧入口的气体读数，单位ppm"
      },
      "sampled_sequence": {
        "type": "array",
        "description": "采样序列，元素可包含 readings/gas_readings 或气体变量"
      },
      "sensor_window": {
        "type": "object",
        "description": "窗口化气体传感输入，包含 samples/readings/gas_readings"
      },
      "structured_timeseries": {
        "type": "object",
        "description": "结构化时序输入，variables 中按气体名给出序列"
      },
      "protocol_ingested_data": {
        "type": "object",
        "description": "协议采集后的气体结构化数据"
      },
      "environmental": {
        "type": "object"
      },
      "context": {
        "type": "object"
      }
    },
    "required": [
      "device_id"
    ],
    "anyOf": [
      {
        "required": [
          "readings"
        ]
      },
      {
        "required": [
          "gas_readings"
        ]
      },
      {
        "required": [
          "sampled_sequence"
        ]
      },
      {
        "required": [
          "sensor_window"
        ]
      },
      {
        "required": [
          "structured_timeseries"
        ]
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "status": {
        "type": "string"
      },
      "label": {
        "type": "string",
        "enum": [
          "normal",
          "warning",
          "abnormal",
          "error",
          "gas_leak"
        ]
      },
      "value": {
        "type": "object"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "metadata": {
        "type": "object"
      },
      "results": {
        "type": "array"
      },
      "alarms": {
        "type": "array"
      },
      "gas_status": {
        "type": "object"
      },
      "predictions": {
        "type": "object"
      },
      "trend_analysis": {
        "type": "object"
      },
      "leak_detection": {
        "type": "object"
      },
      "plugin_name": {
        "type": "string"
      },
      "task_type": {
        "type": "string"
      },
      "summary": {
        "type": "object"
      },
      "anomaly_events": {
        "type": "array"
      },
      "abnormal_intervals": {
        "type": "array"
      },
      "severity": {
        "type": "string"
      },
      "reason_codes": {
        "type": "array"
      },
      "recommended_actions": {
        "type": "array"
      },
      "trend_diagnosis": {
        "type": "object"
      },
      "evidence": {
        "type": "array"
      },
      "review_required": {
        "type": "boolean"
      },
      "model_info": {
        "type": "object"
      },
      "placeholders": {
        "type": "object"
      },
      "input_protocol": {
        "type": "object"
      }
    },
    "required": [
      "success",
      "status",
      "label",
      "value",
      "confidence",
      "metadata",
      "predictions",
      "trend_analysis",
      "summary",
      "anomaly_events",
      "abnormal_intervals",
      "trend_diagnosis",
      "reason_codes",
      "recommended_actions",
      "evidence",
      "model_info",
      "placeholders"
    ]
  },
  "config_schema": {
    "type": "object",
    "required": [
      "sampling",
      "window",
      "thresholds",
      "runtime",
      "model",
      "alarm_rules",
      "upgrade_placeholders"
    ]
  },
  "supported_gases": [
    "SF6",
    "H2",
    "CO",
    "C2H2",
    "CH4",
    "C2H4",
    "C2H6"
  ],
  "supported_voltage_levels": [
    "all"
  ],
  "hardware_requirements": {
    "gas_sensors": false,
    "environmental_sensors": false,
    "smoke_uses_simulated_data": true
  },
  "dependencies": [
    "numpy"
  ],
  "tags": [
    "gas",
    "leakage",
    "monitoring",
    "prediction",
    "timeseries",
    "SF6",
    "DGA"
  ]
}
